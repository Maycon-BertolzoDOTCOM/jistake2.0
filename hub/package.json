{
  "name": "@hub/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "core/*",
    "plugins/*",
    "infra/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "core:dev": "npm run dev --workspace=@hub/core",
    "plugin:security:dev": "npm run dev --workspace=@hub/plugin-security",
    "infra:up": "cd infra && docker-compose up -d"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.0"
}
