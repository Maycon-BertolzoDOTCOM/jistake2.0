{
  "id": "beauty-landing",
  "title": "BeautyOps",
  "theme": {
    "colors": {
      "primary": "#0f172a",
      "accent": "#ec4899"
    },
    "font": "system-ui, sans-serif",
    "radius": "1rem",
    "spacing": "1rem"
  },
  "sections": [
    {
      "id": "hero",
      "constructs": [
        {
          "id": "hero-1",
          "type": "hero",
          "props": {
            "headline": "Agenda lotada?",
            "subheadline": "Não perca cliente. Redirecione para parceiros perto.",
            "ctaLabel": "Quero minha bios",
            "ctaHref": "#precos"
          },
          "visual": {
            "adapter": "gsap",
            "props": {
              "label": "Hero motion"
            }
          }
        }
      ]
    },
    {
      "id": "nail-showcase",
      "constructs": [
        {
          "id": "nail-1",
          "type": "nail-showcase",
          "props": {
            "design": "Nail art favorita",
            "color": "#ec4899",
            "caption": "Cor da página inspirada no design mais curtido"
          },
          "visual": {
            "adapter": "rive",
            "props": {
              "label": "Nail badge"
            }
          }
        }
      ]
    },
    {
      "id": "tabs",
      "constructs": [
        {
          "id": "tabs-1",
          "type": "tabs",
          "props": {
            "items": [
              {
                "label": "Serviços",
                "content": "Manicure, pedicure, nail art"
              },
              {
                "label": "Parceiros",
                "content": "Rede de contingência de bairro"
              },
              {
                "label": "Preços",
                "content": "Bios R$79/mês"
              }
            ]
          },
          "visual": {
            "adapter": "motion",
            "props": {
              "label": "Tabs motion"
            }
          }
        }
      ]
    },
    {
      "id": "features",
      "constructs": [
        {
          "id": "features-1",
          "type": "features",
          "props": {
            "items": [
              {
                "title": "Bios profissional",
                "description": "Site + infra + landing por R$79/mês."
              },
              {
                "title": "Overflow de bairro",
                "description": "Parceiros com capacidade livre em até 5 km."
              },
              {
                "title": "Aprovação manual",
                "description": "Parceiro define quantos pode receber."
              }
            ]
          },
          "visual": {
            "adapter": "three",
            "props": {
              "label": "3D feature"
            }
          }
        }
      ]
    },
    {
      "id": "gallery",
      "constructs": [
        {
          "id": "gallery-1",
          "type": "gallery",
          "props": {
            "items": [
              {
                "src": "/assets/nail-1.jpg",
                "alt": "Nail art 1",
                "caption": "Design favorito"
              }
            ]
          },
          "visual": {
            "adapter": "motion",
            "props": {
              "label": "Gallery drift"
            }
          }
        }
      ]
    },
    {
      "id": "pricing",
      "constructs": [
        {
          "id": "pricing-1",
          "type": "pricing",
          "props": {
            "plans": [
              {
                "name": "Bios",
                "price": "R$79/mês",
                "features": [
                  "Site",
                  "Infra",
                  "Landing"
                ]
              },
              {
                "name": "WhatsApp",
                "price": "R$1.000 setup",
                "features": [
                  "Automação",
                  "Lembretes",
                  "CRM"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cta",
      "constructs": [
        {
          "id": "cta-1",
          "type": "cta",
          "props": {
            "label": "Quero ser parceiro",
            "href": "#contato"
          }
        }
      ]
    }
  ],
  "accessibility": {
    "skipLink": true,
    "landmarkRoles": true
  },
  "perfBudget": {
    "maxHtmlKb": 100
  }
}
